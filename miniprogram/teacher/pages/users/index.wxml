<view class="page theme-{{appearance}}">
  <view class="page-header"><text class="title" aria-role="heading" aria-level="1">用户管理</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert"><text>{{error}}</text></view>
  <view wx:if="{{sessionExpired}}" class="status"><text>登录已失效，账号和密码草稿会保留。</text><button class="primary" bindtap="relogin">重新登录</button></view>
  <view wx:if="{{status}}" class="status"><text>{{status}}</text></view>
  <view wx:if="{{!canManage && !sessionExpired}}" class="status"><text>当前账号没有账号管理权限，请联系学校管理员。</text></view>
  <view wx:if="{{canManage}}" class="toolbar">
    <button class="secondary" bindtap="refresh" loading="{{loading}}" disabled="{{busy || loading || sessionExpired}}">刷新账号</button>
    <button class="primary" bindtap="newUser" disabled="{{busy || loading || !roles.length || editorOpen || resetId || sessionExpired}}">创建账号</button>
  </view>
  <view wx:if="{{editorOpen && draft}}" class="panel">
    <text class="section-heading" aria-role="heading" aria-level="2">{{editId ? '编辑账号' : '创建账号'}}</text>
    <view class="field">
      <text class="label">用户名{{editId ? '（创建后不可修改）' : ''}}</text>
      <input class="input" value="{{draft.username}}" data-field="username" bindinput="inputField" aria-label="用户名" placeholder="3-64 位字母、数字或 ._@-" maxlength="64" disabled="{{busy || editId}}" />
    </view>
    <view class="field"><text class="label">显示名</text><input class="input" value="{{draft.displayName}}" data-field="displayName" bindinput="inputField" aria-label="显示名" maxlength="80" disabled="{{busy}}" /></view>
    <view class="field">
      <text class="label">身份</text>
      <picker class="picker" mode="selector" range="{{roleNames}}" value="{{roleIndex}}" bindchange="chooseRole" aria-label="账号身份" disabled="{{busy || !roles.length}}"><view class="picker-value">{{roleIndex >= 0 ? roleNames[roleIndex] : '当前身份不可授权，请刷新核对'}}</view></picker>
    </view>
    <view wx:if="{{draft.role === 'grade_leader'}}" class="field">
      <text class="label">负责年级</text>
      <picker class="picker" mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="chooseGrade" aria-label="负责年级" disabled="{{busy || !grades.length}}"><view class="picker-value">{{gradeIndex >= 0 ? grades[gradeIndex] : '请选择负责年级'}}</view></picker>
    </view>
    <view wx:if="{{draft.role === 'teacher'}}" class="field">
      <text class="label">带班班级</text>
      <checkbox-group data-field="headClassIds" bindchange="chooseAssignments" aria-label="带班班级，可多选">
        <label wx:for="{{headChoices}}" wx:key="id" class="assignment"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}" aria-label="带班{{item.name}}{{item.isEnabled ? '' : '，班级已停用'}}" /><text>{{item.name}}{{item.isEnabled ? '' : '（已停用）'}}</text></label>
      </checkbox-group>
      <text wx:if="{{!headChoices.length}}" class="empty">暂无可授权班级。</text>
    </view>
    <view wx:if="{{draft.role === 'teacher' || draft.role === 'subject_teacher'}}" class="field">
      <text class="label">任课班级</text>
      <checkbox-group data-field="teachingClassIds" bindchange="chooseAssignments" aria-label="任课班级，可多选">
        <label wx:for="{{teachingChoices}}" wx:key="id" class="assignment"><checkbox value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}" aria-label="任课{{item.name}}{{item.isEnabled ? '' : '，班级已停用'}}" /><text>{{item.name}}{{item.isEnabled ? '' : '（已停用）'}}</text></label>
      </checkbox-group>
      <text wx:if="{{!teachingChoices.length}}" class="empty">暂无可授权班级。</text>
    </view>
    <view wx:if="{{editId}}" class="field">
      <text class="label">账号状态</text>
      <picker class="picker" mode="selector" range="{{statusNames}}" value="{{enabledIndex}}" bindchange="chooseEnabled" aria-label="账号状态" disabled="{{busy}}"><view class="picker-value">{{statusNames[enabledIndex]}}</view></picker>
      <text class="muted">停用或调整授权会使该账号的现有登录失效。</text>
    </view>
    <view wx:else class="field"><text class="label">初始密码</text><input class="input" password value="{{draft.password}}" data-field="password" bindinput="inputField" aria-label="初始密码" placeholder="10-128 个字符，包含字母和数字" maxlength="256" disabled="{{busy}}" /></view>
    <view class="button-row"><button class="primary" bindtap="saveUser" loading="{{busy}}" disabled="{{busy || loading || uncertain || sessionExpired}}">{{editId ? '保存账号' : '创建账号'}}</button><button class="secondary" bindtap="cancelEdit" disabled="{{busy}}">取消编辑</button></view>
  </view>
  <view wx:if="{{resetId}}" class="panel">
    <text class="section-heading" aria-role="heading" aria-level="2">重置密码</text><text class="row-title">{{resetName}}</text>
    <view class="field"><text class="label">新密码</text><input class="input" password value="{{resetPassword}}" bindinput="inputResetPassword" aria-label="{{resetName}}的新密码" placeholder="10-128 个字符，包含字母和数字" maxlength="256" disabled="{{busy}}" /></view>
    <text class="muted">提交后旧密码和该账号的现有登录会立即失效。</text>
    <view class="button-row"><button class="danger" bindtap="submitReset" loading="{{busy}}" disabled="{{busy || loading || uncertain || sessionExpired}}">重置密码</button><button class="secondary" bindtap="cancelReset" disabled="{{busy}}">取消重置</button></view>
  </view>
  <view wx:if="{{canManage}}" class="panel">
    <view class="field"><text class="label">查找账号</text><input class="input" value="{{search}}" bindinput="inputSearch" aria-label="按用户名、显示名、身份或班级查找账号" placeholder="用户名、显示名、身份或班级" disabled="{{busy}}" /></view>
    <text wx:if="{{loading}}" class="status">正在读取账号和授权…</text>
    <view wx:elif="{{!users.length && !error && !sessionExpired}}" class="empty"><text>{{totalUsers ? '没有符合条件的账号。' : '当前管理范围内暂无账号。'}}</text></view>
    <view wx:for="{{users}}" wx:key="id" class="user-item">
      <view class="row"><view class="row-main"><text class="row-title">{{item.display_name}}</text><text class="row-meta">{{item.username}}</text></view><text class="badge">{{item.isEnabled ? '启用' : '已停用'}}</text></view>
      <text class="row-meta">{{item.roleLabel}} · {{item.scopeLabel}}</text>
      <view wx:if="{{item.editable}}" class="button-row">
        <button class="secondary" bindtap="editUser" data-id="{{item.id}}" aria-label="编辑{{item.display_name}}的账号和授权" disabled="{{busy || loading || editorOpen || resetId || sessionExpired}}">编辑账号</button>
        <button class="secondary" bindtap="openReset" data-id="{{item.id}}" aria-label="重置{{item.display_name}}的密码" disabled="{{busy || loading || editorOpen || resetId || sessionExpired}}">重置密码</button>
      </view>
      <text wx:else class="muted">当前账号，仅供查看</text>
    </view>
  </view>
</view>
