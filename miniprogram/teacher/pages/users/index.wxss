.user-item { padding: 16px 0; border-bottom: 1px solid rgba(113, 153, 181, 0.22); }
.user-item:last-child { border-bottom: 0; padding-bottom: 0; }
.row-main { min-width: 0; }
.user-item .row { padding: 0 0 8px; border-bottom: 0; }
.row-title, .row-meta { display: block; overflow-wrap: anywhere; }
.assignment { display: flex; align-items: center; min-height: 44px; padding: 4px 0; }
.assignment text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.assignment checkbox { flex-shrink: 0; margin-right: 8px; }
button, .input, .picker-value { min-height: 44px; }
.picker { padding: 0 12px; }
.picker-value { display: flex; align-items: center; overflow-wrap: anywhere; }
.toolbar, .button-row { flex-wrap: wrap; }
.toolbar { margin-bottom: 20px; }
.button-row button { flex: 1; min-width: 116px; white-space: normal; }
