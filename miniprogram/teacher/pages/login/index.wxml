<view class="page theme-{{appearance}} login-page">
  <view class="login-brand">
    <image src="/assets/app-icon.png" mode="aspectFit" aria-hidden="true" />
    <text>ICeClass 班伴</text>
  </view>
  <view class="panel login-panel">
    <view class="login-intro">
      <view>
        <text class="title" aria-role="heading" aria-level="1">欢迎回来</text>
        <text class="subtitle">使用学校账号，进入教师工作台。</text>
      </view>
      <image wx:if="{{passwordFocus && passwordHidden}}" class="login-mascot" src="/assets/banban/login-cover.png" mode="aspectFit" aria-hidden="true" />
      <image wx:else class="login-mascot" src="/assets/banban/login-rest.png" mode="aspectFit" aria-hidden="true" />
    </view>
    <view>
      <label class="field">
        <text class="label">学校账号</text>
        <input id="login-username" class="input" value="{{username}}" name="username" data-field="username" bindinput="input" maxlength="64" disabled="{{busy}}" aria-label="学校账号" confirm-type="next" bindconfirm="focusPassword" placeholder="请输入学校账号" />
      </label>
      <view class="field">
        <label class="label" for="login-password">密码</label>
        <view class="password-field">
          <input id="login-password" class="input" value="{{password}}" name="password" data-field="password" bindinput="input" password="{{passwordHidden}}" focus="{{passwordFocus}}" bindfocus="focusPassword" bindblur="blurPassword" maxlength="128" disabled="{{busy}}" aria-label="密码" confirm-type="done" bindconfirm="submit" placeholder="请输入密码" />
          <button class="password-toggle quiet-button" bindtap="togglePassword" disabled="{{busy}}" aria-label="{{passwordHidden ? '显示密码' : '隐藏密码'}}">{{passwordHidden ? '显示' : '隐藏'}}</button>
        </view>
      </view>
      <view class="login-agreements">
        <view class="agreement-links">
          <button id="login-terms" class="quiet-button" data-document="terms" bindtap="openAgreement" disabled="{{busy}}">用户服务协议</button>
          <button id="login-privacy" class="quiet-button" data-document="privacy" bindtap="openAgreement" disabled="{{busy}}">隐私政策</button>
        </view>
        <checkbox-group bindchange="changeConsent">
          <label class="agreement-choice">
            <checkbox value="agree" color="#075aa8" checked="{{accepted}}" disabled="{{busy}}" aria-label="我已阅读并同意用户服务协议和隐私政策" />
            <text aria-hidden="true">我已阅读并同意以上协议</text>
          </label>
        </checkbox-group>
      </view>
      <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
      <view class="button-row login-actions">
        <button class="primary" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? '正在登录…' : '登录'}}</button>
        <button class="secondary" bindtap="leave">取消登录</button>
      </view>
    </view>
  </view>
</view>
