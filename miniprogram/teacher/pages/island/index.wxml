<block wx:if="{{sessionExpired}}"><include src="../../templates/login-required.wxml" /></block>
<view wx:else class="page theme-{{appearance}}">
  <view class="page-header">
    <text class="title" aria-role="heading" aria-level="1">课表与浮岛</text>
    <text class="subtitle">查看作息、课程和教室同步回执</text>
  </view>
  <view class="panel">
    <view class="field">
      <text class="label">班级</text>
      <picker range="{{classNames}}" value="{{classIndex}}" disabled="{{loading || sessionExpired || !classes.length}}" bindchange="onClassChange" aria-label="选择课表班级">
        <view class="picker">{{classNames[classIndex] || '暂无可用班级'}}</view>
      </picker>
    </view>
    <button class="secondary" disabled="{{loading || sessionExpired}}" bindtap="load" aria-label="刷新课表与同步状态">刷新课表与状态</button>
    <text wx:if="{{loading}}" class="status" aria-role="status">正在读取课表与同步状态…</text>
    <text wx:if="{{!loading && !classes.length && !error}}" class="empty">暂无可用班级，请联系学校管理员核对授权。</text>
  </view>
  <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
  <block wx:if="{{loaded}}">
    <view class="panel">
      <view class="lesson-heading">
        <text class="row-title">教室浮岛</text>
        <text class="badge">{{enabled ? '已启用' : '未启用'}}</text>
      </view>
      <text class="row-meta">更改课表或浮岛设置，请联系学校管理员。</text>
      <text wx:if="{{syncRevision === 0}}" class="status">本班当前使用默认作息。</text>
    </view>
    <view class="panel">
      <text class="section-heading" aria-role="heading" aria-level="2">每周课程</text>
      <text class="row-meta">首周周一：{{weekAnchor}}。单周、双周和循环值班分别显示，临时调课仍按原配置生效。</text>
      <picker range="{{weekdays}}" value="{{weekdayIndex}}" disabled="{{loading}}" bindchange="onWeekdayChange" aria-label="选择课表星期，{{weekdays[weekdayIndex]}}">
        <view class="picker weekday-picker">{{weekdays[weekdayIndex]}}</view>
      </picker>
      <text wx:if="{{!rows.length}}" class="empty">尚未设置作息，请先在教师工作台设置本班作息时间。</text>
      <view class="lesson" wx:for="{{rows}}" wx:key="key">
        <view class="lesson-heading"><text class="row-title">{{item.slotLabel}}</text><text class="badge">{{item.weekLabel}}</text></view>
        <text class="row-meta">{{item.timeLabel}}{{item.location ? ' · ' + item.location : ''}}</text>
        <text class="lesson-subject">{{item.subject || '暂无安排'}}{{item.teacher ? ' · ' + item.teacher : ''}}</text>
      </view>
    </view>
    <view class="panel">
      <text class="section-heading" aria-role="heading" aria-level="2">作息时间</text>
      <text wx:if="{{!slots.length}}" class="empty">本班尚未配置作息。</text>
      <view class="row" wx:for="{{slots}}" wx:key="id"><text class="row-title row-main">{{item.label}}</text><text class="time">{{item.timeLabel}}</text></view>
    </view>
    <view class="panel">
      <text class="section-heading" aria-role="heading" aria-level="2">教室同步</text>
      <text class="row-meta">服务配置版本 {{syncRevision}}。同步状态来自设备回执，点击刷新获取最新结果。</text>
      <text wx:if="{{!devices.length}}" class="empty">本班暂无已绑定且启用的教室设备。</text>
      <view class="row" wx:for="{{devices}}" wx:key="id">
        <view class="row-main"><text class="row-title">{{item.name}}</text><text class="row-meta">设备版本：{{item.revisionText}} · 回执：{{item.syncedText}}</text><text wx:if="{{item.detail}}" class="row-meta">{{item.detail}}</text></view>
        <text class="badge">{{item.syncText}}</text>
      </view>
    </view>
  </block>
</view>
