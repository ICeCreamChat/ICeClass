.report-filters { display: flex; flex-wrap: wrap; gap: 12px; }
.report-filters .field { flex: 1 1 140px; min-width: 0; }
.all-classes { width: 100%; margin-top: 8px; }
.picker, button { min-height: 44px; box-sizing: border-box; }
.picker { display: flex; align-items: center; white-space: normal; word-break: break-all; }
button { height: auto; padding: 10px 14px; font-size: 16px; font-weight: 600; line-height: 1.5; white-space: normal; }
.report-metrics { display: flex; flex-wrap: wrap; gap: 14px 16px; margin: 16px 0; }
.report-metric { flex: 1 1 110px; min-width: 0; word-break: break-all; }
.report-value { display: block; color: #193c59; font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }
.report-item { padding: 16px 0; border-bottom: 1px solid #7199b538; word-break: break-all; }
.report-item:last-child { border-bottom: 0; }
.report-counts { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 10px 0; font-weight: 600; font-variant-numeric: tabular-nums; }
.report-note { margin-top: 12px; line-height: 1.7; }
.report-pagination { margin-top: 20px; }
