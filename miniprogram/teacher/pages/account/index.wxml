<view class="page theme-{{appearance}} account-page">
  <view class="page-header"><text class="title" aria-role="heading" aria-level="1">账号设置</text></view>
  <view wx:if="{{user}}" class="panel identity-panel">
    <image src="/assets/app-icon.png" mode="aspectFit" aria-hidden="true" />
    <view class="row-main"><text class="section-heading" aria-role="heading" aria-level="2">{{user.displayName || user.username}}</text><text class="row-meta">{{roleName}} · {{user.username}}</text></view>
  </view>
  <text wx:if="{{warning}}" class="status" aria-role="status">{{warning}}</text>

  <view class="panel">
    <text class="section-heading" aria-role="heading" aria-level="2">工作台外观</text>
    <view class="segment">
      <button wx:for="{{appearanceOptions}}" wx:key="id" class="{{appearance === item.id ? 'selected' : ''}}" data-mode="{{item.id}}" bindtap="changeAppearance" aria-pressed="{{appearance === item.id}}" aria-label="{{item.label}}{{appearance === item.id ? '，已选' : ''}}">{{item.label}}</button>
    </view>
    <text wx:if="{{appearanceWarning}}" class="row-meta" aria-role="status">{{appearanceWarning}}</text>
  </view>

  <view class="panel">
    <text class="section-heading" aria-role="heading" aria-level="2">班班</text>
    <view class="button-row">
      <button class="secondary" data-setting="connection" bindtap="openBanbanSetting" disabled="{{busy || sessionExpired}}" aria-label="班班 AI 连接">AI 连接</button>
      <button class="secondary" data-setting="quota" bindtap="openBanbanSetting" disabled="{{busy || sessionExpired}}" aria-label="本月班班用量">我的用量</button>
    </view>
  </view>

  <view class="panel">
    <text class="section-heading" aria-role="heading" aria-level="2">账号与安全</text>
    <label class="field"><text class="label">当前密码</text><input class="input" password value="{{currentPassword}}" data-field="currentPassword" bindinput="input" maxlength="128" disabled="{{busy}}" aria-label="当前密码" /></label>
    <label class="field"><text class="label">新密码</text><input class="input" password value="{{newPassword}}" data-field="newPassword" bindinput="input" maxlength="256" disabled="{{busy}}" aria-label="新密码，10 到 128 个字符，同时包含字母和数字" /></label>
    <label class="field"><text class="label">再次输入新密码</text><input class="input" password value="{{repeatPassword}}" data-field="repeatPassword" bindinput="input" maxlength="256" disabled="{{busy}}" aria-label="再次输入新密码" /></label>
    <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
    <button wx:if="{{sessionExpired}}" class="secondary" bindtap="relogin">重新登录</button>
    <button wx:else class="primary" bindtap="password" loading="{{busy}}" disabled="{{busy}}">修改密码</button>
  </view>
  <view class="button-row">
    <button class="secondary" bindtap="privacy">隐私说明</button>
    <button class="danger" bindtap="logout" disabled="{{busy}}">退出登录</button>
  </view>
</view>
