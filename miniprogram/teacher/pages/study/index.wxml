<view class="page theme-{{appearance || 'glass'}}">
  <view class="page-header"><text class="title" aria-role="heading" aria-level="1">晚自习管理</text><text class="subtitle">调整本班规则，查看运行状态与待核实记录</text></view>
  <view class="panel">
    <view class="field"><text class="label">班级</text>
      <picker range="{{classNames}}" value="{{classIndex}}" disabled="{{busy || loading || !classes.length}}" bindchange="onClassChange" aria-label="选择有带班或管理权限的晚自习班级"><view class="picker">{{classNames[classIndex] || '暂无有权限的班级'}}</view></picker>
    </view>
    <button class="secondary" disabled="{{busy || loading}}" bindtap="onRefresh" aria-label="刷新晚自习配置与事件，保留未保存草稿">刷新设置与记录</button>
    <text wx:if="{{loading}}" class="status" aria-role="status">正在读取晚自习设置与记录…</text>
    <text wx:if="{{!loading && !classes.length && !error}}" class="empty">暂无带班或管理范围内的班级。任课权限不包含晚自习记录。</text>
  </view>
  <text wx:if="{{error}}" class="error" aria-role="alert">{{error}}</text>
  <button wx:if="{{sessionExpired}}" class="primary recovery" bindtap="relogin" disabled="{{busy}}" aria-label="重新登录后继续晚自习核验">重新登录</button>
  <text wx:if="{{status}}" class="status" aria-role="status">{{status}}</text>
  <block wx:if="{{loaded}}">
    <view class="panel">
      <text class="section-heading" aria-role="heading" aria-level="2">当前运行状态</text>
      <text class="row-title">{{stateText}}</text>
      <text class="row-meta">已保存版本 {{savedRevision}} · {{config.enabled ? '本班方案已启用' : '本班方案未启用'}}</text>
      <text class="row-meta">{{nextPeriodText}}</text>
      <text wx:if="{{deviceDetail}}" class="status">{{deviceDetail}}</text>
      <text wx:if="{{runtimeNote}}" class="status">{{runtimeNote}}</text>
      <view class="study-flow" aria-label="感知、观察、AI 复核、提醒、通知的当前运行阶段"><text wx:for="{{flow}}" wx:key="label" class="flow-step {{item.active ? 'active' : ''}}">{{item.label}}{{item.active ? '（当前）' : ''}}</text></view>
      <text class="row-meta">{{inPeriod ? '当前在有效监测时段' : '当前不在有效监测时段'}} · AI 连接{{aiReady ? '可用' : '未就绪'}}</text>
      <text class="row-meta">{{deviceName || '暂无设备状态'}} · 状态上报于 {{deviceUpdated}}</text>
      <text class="row-meta">今日 AI 复核：{{usage.calls == null ? '-' : usage.calls}} / {{config.dailyCalls == null ? '-' : config.dailyCalls}} 次</text>
      <text class="row-meta">今日 token：{{usage.tokens == null ? '-' : usage.tokens}} / {{config.dailyTokens == null ? '-' : config.dailyTokens}}{{usage.estimated ? '（含预占估算）' : ''}}</text>
      <text wx:if="{{dirty}}" class="row-meta">以上状态和用量依据已保存配置，草稿尚未在教室生效。</text>
    </view>
    <view class="panel" wx:if="{{draft}}">
      <text class="section-heading" aria-role="heading" aria-level="2">识别与提醒</text>
      <view class="switch-row"><text class="row-main row-title">本班监测</text><switch checked="{{draft.enabled}}" data-field="enabled" bindchange="onOption" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="启用本班晚自习监测，保存后生效" color="#286bb5" /></view>
      <view class="field">
        <text class="label">识别灵敏度</text>
        <view class="segment"><button wx:for="{{sensitivities}}" wx:key="value" class="{{draft.sensitivity === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="onSensitivity" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="{{'识别灵敏度' + item.label + (draft.sensitivity === item.value ? '，已选择' : '')}}">{{item.label}}</button></view>
        <text class="row-meta">自动适应背景声；正常学习交流不会直接通知老师。</text>
      </view>
      <view class="study-fields">
        <view class="field"><text class="label">进入观察前持续（秒）</text><input class="input" type="digit" value="{{draft.voiceTriggerSeconds}}" data-field="voiceTriggerSeconds" bindinput="onRuleInput" maxlength="6" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="进入观察前持续人声秒数，0.3 至 3 秒" /><text class="row-meta">0.3-3 秒</text></view>
        <view class="field"><text class="label">AI 复核前积累（秒）</text><input class="input" type="number" value="{{draft.observationSeconds}}" data-field="observationSeconds" bindinput="onRuleInput" maxlength="2" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="AI 复核前积累有效片段，10 至 30 秒" /><text class="row-meta">10-30 秒</text></view>
        <view class="field"><text class="label">提醒后等待（秒）</text><input class="input" type="number" value="{{draft.reminderWaitSeconds}}" data-field="reminderWaitSeconds" bindinput="onRuleInput" maxlength="3" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="实际显示提醒后至少等待，90 至 300 秒" /><text class="row-meta">90-300 秒</text></view>
        <view class="field"><text class="label">提醒后再确认（次）</text><input class="input" type="number" value="{{draft.confirmationsAfterReminder}}" data-field="confirmationsAfterReminder" bindinput="onRuleInput" maxlength="1" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="提醒后新的 AI 闲聊确认次数，1 至 3 次" /><text class="row-meta">1-3 次，使用新的独立片段</text></view>
      </view>
      <text class="row-meta">先在教室提醒，持续疑似闲聊才通知班主任。各次复核至少间隔 90 秒。</text>
    </view>
    <view class="panel" wx:if="{{draft}}">
      <text class="section-heading" aria-role="heading" aria-level="2">监测选项</text>
      <view class="switch-row"><view class="row-main"><text class="row-title">AI 复核</text><text class="row-meta">疑似片段短文本使用班主任现有 AI 连接</text></view><switch checked="{{draft.aiEnabled}}" data-field="aiEnabled" bindchange="onOption" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="启用晚自习 AI 短文本复核，保存后生效" color="#286bb5" /></view>
      <view class="switch-row"><view class="row-main"><text class="row-title">通知时附现场照片</text><text class="row-meta">仅上报通知时拍摄，供人工核实；照片保留 24 小时，不发送给 AI</text></view><switch checked="{{draft.photoEnabled}}" data-field="photoEnabled" bindchange="onOption" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="晚自习通知时附一张现场照片，保存后生效" color="#286bb5" /></view>
      <checkbox-group bindchange="onAuthorized" aria-label="学校告知与授权确认"><label class="authorization"><checkbox value="authorized" checked="{{draft.authorized}}" disabled="{{!canEdit || busy || loading || sessionExpired}}" color="#286bb5" aria-label="已完成学校告知与授权，启用监测前需确认" /><text>已完成学校告知与授权</text></label></checkbox-group>
      <button class="secondary disclosure" bindtap="onBudgetToggle" disabled="{{busy}}" aria-label="{{budgetOpen ? '收起每日 AI 额度' : '展开每日 AI 额度'}}">{{budgetOpen ? '收起 AI 额度' : '调整 AI 额度'}}</button>
      <view wx:if="{{budgetOpen}}" class="study-fields budget-fields">
        <view class="field"><text class="label">每日 AI 复核（次）</text><input class="input" type="number" value="{{draft.dailyCalls}}" data-field="dailyCalls" bindinput="onRuleInput" maxlength="1" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="每班每日 AI 复核上限，0 至 4 次，0 表示不调用" /><text class="row-meta">0-4 次，0 表示不调用</text></view>
        <view class="field"><text class="label">每日 token 上限</text><input class="input" type="number" value="{{draft.dailyTokens}}" data-field="dailyTokens" bindinput="onRuleInput" maxlength="4" disabled="{{!canEdit || busy || loading || sessionExpired}}" aria-label="每班每日 token 上限，1500 至 2400" /><text class="row-meta">1500-2400 token</text></view>
      </view>
      <text class="row-meta">{{budgetNote}}</text>
    </view>
    <view class="panel" wx:if="{{draft}}">
      <text wx:if="{{!canEdit}}" class="status">当前无法修改本班设置，请刷新核对带班或管理权限。草稿已保留。</text>
      <text wx:if="{{dirty}}" class="status">本班有未保存草稿，基于版本 {{revision}}。切换班级和同账号重新登录后仍会保留。</text>
      <text wx:if="{{uncertain}}" class="error">保存结果尚未确认，请先刷新核对，避免重复提交。</text>
      <text wx:if="{{conflict}}" class="status">设置版本已变化，请核对当前草稿并重新载入最新设置。</text>
      <view class="button-row"><button class="primary" bindtap="onSave" loading="{{saving}}" disabled="{{!canEdit || !dirty || busy || loading || conflict || uncertain || sessionExpired}}" aria-label="核对本班影响范围并保存晚自习设置">保存设置</button><button class="secondary" bindtap="onDiscard" disabled="{{busy || loading || sessionExpired}}" aria-label="放弃当前班级草稿并重新载入最新晚自习设置">重新载入最新设置</button></view>
    </view>
    <view class="panel">
      <text class="section-heading" aria-role="heading" aria-level="2">课表安排</text>
      <text class="row-meta">直接使用本班课表的第二节晚自习，包含循环值班和临时调课。</text>
      <text wx:if="{{!schedule.length}}" class="empty">近期没有有效的第二节晚自习安排，请检查本班课表。</text>
      <view class="row" wx:for="{{schedule}}" wx:key="key"><view class="row-main"><text class="row-title">{{item.title}}{{item.temporary ? ' · 临时调课' : ''}}</text><text class="row-meta">{{item.startText}} - {{item.endText}}</text></view></view>
      <button class="secondary timetable" bindtap="openTimetable" disabled="{{busy || loading || sessionExpired}}" aria-label="进入当前班级课表查看或编辑晚自习安排">查看本班课表</button>
    </view>
    <view class="panel">
      <text class="section-heading" aria-role="heading" aria-level="2">核验记录</text>
      <view class="switch-row"><text class="row-main">本班 {{pending}} 条待核实</text><text class="small muted">只看待核</text><switch checked="{{onlyPending}}" disabled="{{busy || loading}}" bindchange="onPendingChange" aria-label="只显示待人工核实的晚自习记录" color="#286bb5" /></view>
      <text class="row-meta">显示最近最多 100 条；待核数量按服务端全部记录统计。照片保留 24 小时，需主动点击查看。</text>
      <text wx:if="{{!visibleEvents.length}}" class="empty">{{onlyPending ? '当前读取的记录中暂无待核事件。' : '暂无晚自习事件记录。'}}</text>
      <view class="event" wx:for="{{visibleEvents}}" wx:key="id">
        <view class="event-heading"><text class="row-title">{{item.atText}}</text><text class="badge">{{item.statusText}}</text></view>
        <text class="row-meta">{{item.photoText}}</text>
        <text wx:if="{{item.handled_at != null}}" class="row-meta">人工核验于 {{item.handledText}}</text>
        <text wx:if="{{item.blocked}}" class="status">该记录状态需刷新核对，暂不重复提交处理结果。</text>
        <view class="button-row" wx:if="{{item.canViewPhoto || item.needsReview}}">
          <button wx:if="{{item.canViewPhoto}}" class="secondary" data-id="{{item.id}}" bindtap="onPhoto" disabled="{{busy || loading || sessionExpired}}" aria-label="{{'手动查看' + item.atText + '的受保护事件照片'}}">查看照片</button>
          <button wx:if="{{item.needsReview}}" class="secondary" data-id="{{item.id}}" data-resolution="false_alarm" bindtap="onReview" disabled="{{busy || loading || item.blocked || sessionExpired}}" aria-label="{{'人工确认' + item.atText + '的事件为误报'}}">确认误报</button>
          <button wx:if="{{item.needsReview}}" class="primary" data-id="{{item.id}}" data-resolution="handled" bindtap="onReview" disabled="{{busy || loading || item.blocked || sessionExpired}}" aria-label="{{'将' + item.atText + '的事件标记为人工处理完成'}}">人工处理完成</button>
        </view>
        <view wx:if="{{photoPath && photoId === item.id}}" class="photo-panel">
          <text class="label">事件现场照片</text>
          <image class="event-photo" src="{{photoPath}}" mode="widthFix" show-menu-by-longpress="{{false}}" aria-label="{{photoLabel}}" binderror="onPhotoError" />
          <text class="row-meta">仅供本班人工核实。查看不会改变处理状态；过期或离开页面后自动关闭。</text>
          <button class="secondary" bindtap="onClosePhoto" aria-label="关闭晚自习事件照片">关闭照片</button>
        </view>
      </view>
    </view>
  </block>
</view>
