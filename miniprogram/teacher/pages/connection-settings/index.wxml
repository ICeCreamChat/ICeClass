<view class="page theme-{{appearance}}">
  <view class="page-header"><text class="title">班班 AI 连接</text><text class="subtitle">选择学校连接，或为本账号配置自己的模型服务。</text></view>
  <view wx:if="canManageSchool" class="segment workspace" aria-label="连接设置范围">
    <button class="{{workspace === 'account' ? 'selected' : ''}}" aria-label="本账号连接设置" data-workspace="account" disabled="{{busy || sessionExpired}}" bindtap="changeWorkspace">本账号连接</button>
    <button class="{{workspace === 'school' ? 'selected' : ''}}" aria-label="全校共用连接设置" data-workspace="school" disabled="{{busy || sessionExpired}}" bindtap="changeWorkspace">学校共用连接</button>
  </view>
  <view wx:if="error" class="error" role="alert">{{error}}</view>
  <view wx:if="sessionExpired" class="status"><text>登录已失效，连接草稿已保留。</text><button class="primary" bindtap="relogin">重新登录</button></view>
  <text wx:if="status" class="status" role="status">{{status}}</text>
  <view class="panel">
    <view class="toolbar"><text class="section-heading">{{workspace === 'school' ? '学校共用配置' : '本账号使用方式'}}</text><button class="secondary" disabled="{{busy || loading || sessionExpired}}" bindtap="refresh">重新载入</button></view>
    <text wx:if="loading" class="status">正在读取连接设置…</text>
    <text wx:if="!loading && !draft" class="empty">暂未读取到连接设置，请重新载入。</text>
    <block wx:if="draft">
      <text class="row-meta">已保存：{{savedSource}} · {{savedEnabled ? '已启用' : '已停用'}} · {{configured ? '已配置密钥' : '未配置密钥'}}</text>
      <block wx:if="workspace === 'account'">
        <view class="segment source" aria-label="本账号连接来源">
          <button class="{{draft.source === 'school' ? 'selected' : ''}}" data-source="school" disabled="{{busy || loading || sessionExpired}}" bindtap="changeSource">使用学校连接</button>
          <button class="{{draft.source === 'personal' ? 'selected' : ''}}" data-source="personal" disabled="{{busy || loading || sessionExpired}}" bindtap="changeSource">使用自己的连接</button>
        </view>
        <text wx:if="draft.source === 'school'" class="status">学校连接：{{schoolLabel}}。选择学校连接会保留本人已保存的个人配置。</text>
      </block>
      <text wx:if="workspace === 'school'" class="status">此处修改影响所有选择学校连接的账号，请核对后保存。</text>
      <block wx:if="workspace === 'school' || draft.source === 'personal'">
        <view class="field"><label class="label" for="connection-url">服务地址 Base URL</label><input id="connection-url" class="input" aria-label="模型服务 HTTPS Base URL" value="{{draft.baseUrl}}" maxlength="1000" disabled="{{busy || loading || sessionExpired}}" data-field="baseUrl" bindinput="inputField" placeholder="服务商提供的公网 HTTPS 地址" /></view>
        <view class="field"><label class="label" for="connection-model">模型 ID</label><input id="connection-model" class="input" aria-label="模型 ID" value="{{draft.model}}" maxlength="200" disabled="{{busy || loading || sessionExpired}}" data-field="model" bindinput="inputField" placeholder="填写服务商提供的模型名称" /></view>
        <view class="field"><label class="label" for="connection-key">新 API Key</label><input id="connection-key" class="input" aria-label="新的模型服务密钥，留空保留原密钥" password="{{true}}" value="{{draft.apiKey}}" maxlength="4096" disabled="{{busy || loading || sessionExpired}}" data-field="apiKey" bindinput="inputField" placeholder="留空保留原密钥" /><text class="row-meta">{{keyConfigured ? '此配置已有密钥。' : '此配置尚未保存密钥。'}}密钥仅在内存草稿中保留，保存成功后清空输入框。更换服务地址时，需重新填写对应密钥。</text></view>
        <checkbox-group aria-label="连接启用和密钥清理选项" bindchange="changeFlags">
          <label class="check-option"><checkbox value="enabled" aria-label="启用此 AI 连接" checked="{{draft.enabled}}" disabled="{{busy || loading || sessionExpired}}" />启用此连接</label>
          <label class="check-option"><checkbox value="clearKey" aria-label="保存时清除已保存的 API Key" checked="{{draft.clearKey}}" disabled="{{busy || loading || sessionExpired}}" />保存时清除已有密钥</label>
        </checkbox-group>
      </block>
      <text wx:if="dirty" class="status">有尚未保存的连接设置。切换工作区会保留草稿；请保存后再测试。</text>
      <text wx:if="conflict || uncertain" class="status">{{uncertain ? '操作结果不明确，请重新载入核对。' : '设置已变化或服务正忙，请重新载入后核对。'}}草稿已保留，不会自动覆盖或重试。</text>
      <view class="button-row"><button class="secondary" disabled="{{busy || loading || dirty || conflict || uncertain || sessionExpired || !configured || !savedEnabled}}" bindtap="testConnection">测试已保存连接</button><button class="primary" loading="{{busy}}" disabled="{{busy || loading || !dirty || conflict || uncertain || sessionExpired}}" bindtap="save">保存连接</button></view>
      <text class="row-meta boundary">多人同时调整连接时，请先与其他管理员核对，避免互相覆盖。</text>
    </block>
  </view>
</view>
