<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ICeClass.Receiver.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <FontFamily x:Key="ContentControlThemeFontFamily">Microsoft YaHei UI, Microsoft YaHei, Segoe UI</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ICeClass/NativeControls.axaml" />
  </Application.Styles>
</Application>
