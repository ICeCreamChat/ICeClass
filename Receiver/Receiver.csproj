<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <AssemblyName>ICeClass</AssemblyName>
    <RootNamespace>ICeClass.Receiver</RootNamespace>
    <Version>2.5.10</Version>
    <EmbedVoiceResources Condition="'$(EmbedVoiceResources)' == ''">true</EmbedVoiceResources>
    <Product>ICeClass 班伴</Product>
    <Title>ICeClass 班伴 · 教室端</Title>
    <Description>班级伴学与管理平台</Description>
    <Company>ICeCreamChat</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
    <IslandOpticsDirectory>$(MSBuildProjectDirectory)\obj\island-optics\x64</IslandOpticsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\acknowledgements-default.json" LogicalName="ICeClass.About.acknowledgements.json" />
    <Content Include="$(IslandOpticsDirectory)\ICeClass.Glass.dll" Link="ICeClass.Glass.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <EmbeddedResource Include="Assets\Icons\*.svg" LogicalName="ICeClass.Classroom.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\About\banban-bow.webp" LogicalName="ICeClass.About.banban-bow.webp" />
    <EmbeddedResource Include="Assets\Banban\*.webp" LogicalName="ICeClass.Island.banban.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Voice\*" Exclude="Assets\Voice\manifest.json" LogicalName="ICeClass.Voice.%(Filename)%(Extension)" Condition="'$(EmbedVoiceResources)' != 'false'" />
    <EmbeddedResource Include="Assets\Voice\manifest.json" LogicalName="ICeClass.Voice.manifest.json" />
    <EmbeddedResource Include="Assets\Voice\Asr\manifest.json" LogicalName="ICeClass.Voice.Asr.manifest.json" Condition="'$(EmbedVoiceResources)' == 'false'" />
    <EmbeddedResource Include="Assets\Voice\Tts\manifest.json" LogicalName="ICeClass.Voice.Tts.manifest.json" Condition="'$(EmbedVoiceResources)' == 'false'" />
    <EmbeddedResource Include="Assets\Voice\Vad\manifest.json" LogicalName="ICeClass.Voice.Vad.manifest.json" Condition="'$(EmbedVoiceResources)' == 'false'" />
    <EmbeddedResource Include="Assets\Voice\Speaker\manifest.json" LogicalName="ICeClass.Voice.Speaker.manifest.json" Condition="'$(EmbedVoiceResources)' == 'false'" />
    <EmbeddedResource Include="Assets\Voice\Asr\*" LogicalName="ICeClass.Voice.Asr.%(Filename)%(Extension)" Condition="'$(EmbedVoiceResources)' != 'false'" />
    <EmbeddedResource Include="Assets\Voice\Tts\*" LogicalName="ICeClass.Voice.Tts.%(Filename)%(Extension)" Condition="'$(EmbedVoiceResources)' != 'false'" />
    <EmbeddedResource Include="Assets\Voice\Vad\*" LogicalName="ICeClass.Voice.Vad.%(Filename)%(Extension)" Condition="'$(EmbedVoiceResources)' != 'false'" />
    <EmbeddedResource Include="Assets\Voice\Speaker\*" LogicalName="ICeClass.Voice.Speaker.%(Filename)%(Extension)" Condition="'$(EmbedVoiceResources)' != 'false'" />
    <EmbeddedResource Include="Assets\Sounds\notification-*.wav" LogicalName="ICeClass.Notification.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\assets\banban\*.webp" LogicalName="ICeClass.Island.banban.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\assets\banban\rig\forearm-right.webp;..\web_controller\assets\banban\rig\socket-*.webp;..\web_controller\assets\banban\rig\iris-*.webp;..\web_controller\assets\banban\rig\lash-*.webp;..\web_controller\assets\banban\rig\smile-*.webp" LogicalName="ICeClass.Island.banban.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\reading\**\*" LogicalName="ICeClass.Local/reading/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\homework\classroom\**\*" LogicalName="ICeClass.Local/homework/classroom/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\assets\*" LogicalName="ICeClass.Local/assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\favicon.ico" LogicalName="ICeClass.Local/favicon.ico" />
    <EmbeddedResource Include="..\branding\app.ico" LogicalName="ICeClass.Branding.app.ico" />
    <EmbeddedResource Include="..\branding\app-icon.png" LogicalName="ICeClass.Branding.app-icon.png" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="ICeClass.Notices.LICENSE" />
    <EmbeddedResource Include="..\docs\licenses\THIRD_PARTY_NOTICES.md" LogicalName="ICeClass.Notices.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="..\docs\licenses\WebView2-LICENSE.txt" LogicalName="ICeClass.Notices.WebView2-LICENSE.txt" />
    <EmbeddedResource Include="..\docs\licenses\WebView2-NOTICE.txt" LogicalName="ICeClass.Notices.WebView2-NOTICE.txt" />
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.0" />
  </ItemGroup>
  <Target Name="UseWebViewCoreOnly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
  <Target Name="BuildIslandOptics" BeforeTargets="PrepareForBuild"
          Inputs="Native\IslandGlassCapture.cpp;..\scripts\build-island-optics.ps1"
          Outputs="$(IslandOpticsDirectory)\ICeClass.Glass.dll">
    <Error Condition="'$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != 'win-x64'" Text="The classroom native capture build currently targets Windows x64." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\build-island-optics.ps1&quot; -OutputDirectory &quot;$(IslandOpticsDirectory)&quot;" />
  </Target>
</Project>
