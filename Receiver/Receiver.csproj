<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>false</UseWPF>
    <AssemblyName>ICeClass</AssemblyName>
    <RootNamespace>ICeClass.Receiver</RootNamespace>
    <Version>2.5.0</Version>
    <Product>ICeClass 班伴</Product>
    <Title>ICeClass 班伴 · 教室端</Title>
    <Description>班级伴学与管理平台</Description>
    <Company>ICeCreamChat</Company>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\branding\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
    <EmbeddedResource Include="Assets\Icons\*.svg" LogicalName="ICeClass.Classroom.Icons.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Banban\*.webp" LogicalName="ICeClass.Island.banban.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Voice\*" LogicalName="ICeClass.Voice.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Voice\Asr\*" LogicalName="ICeClass.Voice.Asr.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Voice\Tts\*" LogicalName="ICeClass.Voice.Tts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Voice\Vad\*" LogicalName="ICeClass.Voice.Vad.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Voice\Speaker\*" LogicalName="ICeClass.Voice.Speaker.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\assets\banban\*.webp" LogicalName="ICeClass.Island.banban.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\assets\banban\rig\forearm-right.webp;..\web_controller\assets\banban\rig\socket-*.webp;..\web_controller\assets\banban\rig\iris-*.webp;..\web_controller\assets\banban\rig\lash-*.webp;..\web_controller\assets\banban\rig\smile-*.webp" LogicalName="ICeClass.Island.banban.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\reading\**\*" LogicalName="ICeClass.Local/reading/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\assets\*" LogicalName="ICeClass.Local/assets/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\web_controller\favicon.ico" LogicalName="ICeClass.Local/favicon.ico" />
    <EmbeddedResource Include="..\branding\app.ico" LogicalName="ICeClass.Branding.app.ico" />
    <EmbeddedResource Include="..\branding\app-icon.png" LogicalName="ICeClass.Branding.app-icon.png" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="ICeClass.Notices.LICENSE" />
    <EmbeddedResource Include="..\docs\licenses\THIRD_PARTY_NOTICES.md" LogicalName="ICeClass.Notices.THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="..\docs\licenses\WebView2-LICENSE.txt" LogicalName="ICeClass.Notices.WebView2-LICENSE.txt" />
    <EmbeddedResource Include="..\docs\licenses\WebView2-NOTICE.txt" LogicalName="ICeClass.Notices.WebView2-NOTICE.txt" />
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="2.0.0" />
  </ItemGroup>
  <Target Name="UseWebViewCoreOnly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>
</Project>
