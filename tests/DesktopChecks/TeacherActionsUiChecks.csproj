<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/teacher-actions-ui/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/teacher-actions-ui/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);TEACHER_ACTION_UI_CHECKS</DefineConstants>
    <AssemblyName>DesktopChecks</AssemblyName>
    <ApplicationManifest>../../Receiver/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="TeacherActionsUiChecks.cs" />
    <ProjectReference Include="../../Desktop/ICeClass.Desktop.csproj" />
  </ItemGroup>
  <Target Name="UseWebViewCoreOnly" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" /></ItemGroup>
  </Target>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
