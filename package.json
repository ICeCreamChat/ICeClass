{
  "name": "iceclass",
  "version": "2.0.1",
  "private": true,
  "scripts": {
    "dev": "python server/preview.py",
    "dev:cloud-legacy": "wrangler dev",
    "deploy": "deploy-tencent-server.bat",
    "deploy:cloud-legacy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply iceclass --local",
    "db:remote": "wrangler d1 migrations apply iceclass --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.132.0"
  }
}
